---
import Base from '../layouts/Base.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { links, copy, withBase } from '../config/site';

const socials = [
  { name: 'linkedin', label: 'LinkedIn', href: links.linkedin, size: 24 },
  { name: 'x', label: 'X', href: links.x, size: 22 },
  { name: 'github', label: 'GitHub', href: links.github, size: 24 },
  { name: 'instagram', label: 'Instagram', href: links.instagram, size: 23 },
] as const;
---

<Base
  title="Luke To"
  description="Student @ UC Berkeley & Founder."
  ground="#04070d"
>
  <!-- The whiteout navigates at 780ms; prefetching makes the swap land inside that window. -->
  <link slot="head" rel="prefetch" href={withBase('/about/')} />

  <div class="field" id="field">
    <canvas class="canvas" id="ascii" aria-hidden="true"></canvas>

    <div class="notice" id="notice">
      <span class="notice-dot"></span>
      <span class="notice-text">this site is better on desktop</span>
      <button class="notice-x" id="notice-dismiss" type="button" aria-label="Dismiss">
        &times;
      </button>
    </div>

    <div class="star" aria-hidden="true">&#10033;</div>

    <div class="stack">
      <h1 class="title">
        <span class="title-type">{copy.name}</span><span class="cursor" aria-hidden="true"
        ></span>
      </h1>

      <p class="role">{copy.role}</p>

      <p class="building">
        currently building <a href={links.project}>{copy.projectName} &#8599;</a>
      </p>

      <div class="socials">
        {
          socials.map((s) => (
            <a href={s.href} aria-label={s.label}>
              <SocialIcon name={s.name} size={s.size} />
            </a>
          ))
        }
      </div>

      <button class="cta" id="cta" type="button">Learn More</button>
    </div>

    <div class="whiteout" id="whiteout" aria-hidden="true"></div>
  </div>
</Base>

<style>
  .field {
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: #04070d;
    cursor: crosshair;
  }

  .canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .star {
    position: absolute;
    top: 26px;
    right: 30px;
    color: #d9a441;
    font: 400 20px 'JetBrains Mono', ui-monospace, monospace;
    text-shadow: 0 0 12px rgba(217, 164, 65, 0.7);
  }

  .stack {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  /*
   * align-items:baseline puts the cursor's bottom edge exactly on the text
   * baseline, and .74em matches JetBrains Mono's cap height so the cursor top
   * aligns with the L. Both are deliberate — center/.92em left the cursor
   * hanging below the descender-free name.
   */
  .title {
    display: flex;
    align-items: baseline;
    margin: 0;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-weight: 500;
    font-size: clamp(46px, 5.9vw, 84px);
    line-height: 1.1;
    color: #fff;
    letter-spacing: -0.02em;
    text-shadow:
      0 0 3px rgba(255, 255, 255, 0.7),
      0 0 30px rgba(140, 190, 255, 0.35);
  }

  .title-type {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: baseline;
    animation: typeIn 620ms steps(7, end) both;
  }

  .cursor {
    display: inline-block;
    width: 0.56em;
    height: 0.74em;
    margin-left: 0.08em;
    background: #fff;
    animation: blink 1.1s steps(2, end) infinite;
  }

  .role {
    margin: 24px 0 0;
    padding: 0 24px;
    text-align: center;
    font: 500 14px 'JetBrains Mono', ui-monospace, monospace;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    animation: softIn 460ms cubic-bezier(0.2, 0.7, 0.3, 1) 700ms both;
  }

  .building {
    margin: 12px 0 0;
    padding: 0 24px;
    text-align: center;
    font: 400 13px 'JetBrains Mono', ui-monospace, monospace;
    color: rgba(255, 255, 255, 0.5);
    animation: softIn 460ms cubic-bezier(0.2, 0.7, 0.3, 1) 790ms both;
  }

  .building a {
    color: rgba(255, 255, 255, 0.88);
    text-decoration: none;
    transition:
      color 0.18s ease,
      text-shadow 0.18s ease;
  }

  .building a:hover {
    color: #fff;
    text-shadow:
      0 0 6px rgba(255, 255, 255, 0.85),
      0 0 18px rgba(150, 195, 255, 0.6);
  }

  .socials {
    margin-top: 18px;
    display: flex;
    gap: 26px;
    align-items: center;
  }

  .socials a {
    display: flex;
    color: #fff;
    opacity: 0.72;
    transition:
      opacity 0.18s ease,
      filter 0.18s ease;
  }

  .socials a:hover {
    color: #fff;
    opacity: 1;
    filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.85))
      drop-shadow(0 0 16px rgba(150, 195, 255, 0.6));
  }

  .cta {
    margin-top: 20px;
    padding: 15px 44px;
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.34);
    font: 500 12px 'JetBrains Mono', ui-monospace, monospace;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: #fff;
    cursor: pointer;
    transition:
      background 0.18s ease,
      box-shadow 0.18s ease;
  }

  .cta:hover {
    background: rgba(255, 255, 255, 0.12);
    box-shadow: 0 0 22px rgba(150, 195, 255, 0.35);
  }

  .cta:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.7);
    outline-offset: 3px;
  }

  .whiteout {
    position: absolute;
    inset: 0;
    z-index: 10;
    background: #eef1ee;
    opacity: 0;
    pointer-events: none;
  }

  .whiteout.on {
    animation: fxWhite 820ms cubic-bezier(0.55, 0, 0.85, 0.65) both;
  }

  /* Mobile notice — mobile only. */
  .notice {
    display: none;
  }

  @media (max-width: 759.98px) {
    .notice {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      z-index: 5;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 14px;
      background: rgba(255, 255, 255, 0.07);
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(6px);
      animation: softIn 420ms cubic-bezier(0.2, 0.7, 0.3, 1) 200ms both;
    }

    .title {
      font-size: 40px;
    }

    .role {
      margin-top: 18px;
      font-size: 11px;
    }

    .building {
      font-size: 11.5px;
    }

    .socials {
      gap: 20px;
    }

    .cta {
      padding: 14px 30px;
    }
  }

  .notice-dot {
    flex: none;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #d9a441;
    box-shadow: 0 0 7px rgba(217, 164, 65, 0.9);
  }

  .notice-text {
    flex: 1;
    font: 400 10.5px/1.45 'JetBrains Mono', ui-monospace, monospace;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.62);
  }

  .notice-x {
    flex: none;
    padding: 3px 7px;
    border: none;
    background: none;
    font: 500 10.5px 'JetBrains Mono', ui-monospace, monospace;
    color: rgba(255, 255, 255, 0.5);
    cursor: pointer;
  }

  .notice-x:hover {
    color: #fff;
  }
</style>

<script>
  import { createAsciiField, WHITEOUT_MS } from '../scripts/ascii-field';
  import { fieldDefaults, withBase } from '../config/site';

  const ABOUT_URL = withBase('/about/');

  const container = document.getElementById('field') as HTMLElement;
  const canvas = document.getElementById('ascii') as HTMLCanvasElement;
  const cta = document.getElementById('cta') as HTMLButtonElement;
  const overlay = document.getElementById('whiteout') as HTMLElement;
  const notice = document.getElementById('notice');
  const dismiss = document.getElementById('notice-dismiss');

  const field = createAsciiField(canvas, container, fieldDefaults);

  /** The route is pushed just before the overlay is fully opaque; the lead hides the swap. */
  const NAV_LEAD_MS = 40;
  let navigating = false;

  cta.addEventListener('click', () => {
    // Re-entry guard: a click while the transition is in flight is ignored.
    if (navigating) return;
    navigating = true;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      window.location.href = ABOUT_URL;
      return;
    }

    field.startWhiteout();
    overlay.classList.add('on');
    window.setTimeout(() => {
      window.location.href = ABOUT_URL;
    }, WHITEOUT_MS - NAV_LEAD_MS);
  });

  // Dismissal is session-only.
  const NOTICE_KEY = 'noticeOff';
  if (sessionStorage.getItem(NOTICE_KEY) === '1') notice?.remove();
  dismiss?.addEventListener('click', () => {
    sessionStorage.setItem(NOTICE_KEY, '1');
    notice?.remove();
  });

  window.addEventListener('pagehide', () => field.destroy());
</script>
