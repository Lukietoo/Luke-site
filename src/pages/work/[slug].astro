---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ChromeBar from '../../components/ChromeBar.astro';
import { withBase } from '../../config/site';
import {
  openProjects,
  placeholderIntro,
  caseNumber,
  nextOpen,
  type Project,
} from '../../config/work';

// Locked projects are placeholders with nothing to show, so they get no page —
// which also makes /work/basecase/ a 404 rather than an empty case study.
export function getStaticPaths() {
  return openProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const [hero, detailA, detailB] = project.shots!;
const next = nextOpen(project);
const liveUrl = `https://${project.host}`;
const WORK = withBase('/work/');
---

<Base
  title={`${project.name} — Luke To`}
  description={`${project.name}: ${project.role} by Luke To.`}
  ground="#eef1ee"
>
  <div class="page">
    <a class="back" href={WORK} aria-label="Back to work">←</a>

    <div class="col">
      <p class="eyebrow">case {caseNumber(project)} — {project.role}</p>
      <h1 class="title">{project.name}</h1>
      <p class="intro">{project.intro ?? placeholderIntro}</p>

      {/* Unit line-heights so the mono labels share a baseline with the values. */}
      <dl class="meta">
        <dt>role</dt>
        <dd>{project.role}</dd>
        <dt>live</dt>
        <dd>
          <a href={liveUrl} target="_blank" rel="noopener">{project.host} ↗</a>
        </dd>
      </dl>

      <div class="open-row">
        <a class="open" href={liveUrl} target="_blank" rel="noopener">
          Open {project.name} ↗
        </a>
        <span class="open-host" aria-hidden="true">{project.host}</span>
      </div>

      <div class="shots">
        <div class="hero-frame">
          <ChromeBar size="hero" />
          <div class="well">
            <Image
              class="shot"
              src={hero}
              alt={`${project.name} — hero screenshot`}
              widths={[900, 1800]}
              sizes="(max-width: 759.98px) 100vw, 900px"
              loading="eager"
            />
          </div>
        </div>

        <div class="details">
          <div class="well detail">
            <Image
              class="shot"
              src={detailA}
              alt={`${project.name} — detail screenshot 1`}
              widths={[440, 880]}
              sizes="(max-width: 759.98px) 100vw, 440px"
              loading="lazy"
            />
          </div>
          <div class="well detail">
            <Image
              class="shot"
              src={detailB}
              alt={`${project.name} — detail screenshot 2`}
              widths={[440, 880]}
              sizes="(max-width: 759.98px) 100vw, 440px"
              loading="lazy"
            />
          </div>
        </div>
      </div>

      <nav class="foot">
        <a class="all" href={WORK}>← all work</a>
        <a class="next" href={withBase(`/work/${next.slug}/`)}>
          next — {next.name} →
        </a>
      </nav>
    </div>
  </div>
</Base>

<style>
  .page {
    position: relative;
    padding: 84px 44px 100px;
    min-height: 100vh;
    box-sizing: border-box;
    background: #eef1ee;
    animation: fadeup 0.35s ease both;
  }

  .back {
    position: absolute;
    top: 34px;
    left: 34px;
    z-index: 20;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    font: 700 15px Helvetica, 'Helvetica Neue', Arial, sans-serif;
    color: #1a1a1a;
    text-decoration: none;
  }

  .back:hover {
    background: rgba(0, 0, 0, 0.12);
    color: #1a1a1a;
  }

  .back:focus-visible {
    outline: 2px solid rgba(0, 0, 0, 0.45);
    outline-offset: 2px;
  }

  .col {
    max-width: 900px;
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0;
    font: 500 10.5px 'JetBrains Mono', ui-monospace, monospace;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.38);
  }

  .title {
    margin: 14px 0 0;
    font: 700 56px/1.02 Helvetica, 'Helvetica Neue', Arial, sans-serif;
    color: #0d0d0d;
    letter-spacing: -0.03em;
  }

  .intro {
    margin: 18px 0 0;
    max-width: 520px;
    font: 400 16px/1.65 Helvetica, 'Helvetica Neue', Arial, sans-serif;
    color: rgba(0, 0, 0, 0.68);
    text-wrap: pretty;
  }

  .meta {
    margin: 30px 0 0;
    padding: 22px 0;
    display: grid;
    grid-template-columns: 110px 1fr;
    row-gap: 14px;
    column-gap: 24px;
    align-items: baseline;
    border-top: 1px solid rgba(0, 0, 0, 0.11);
    border-bottom: 1px solid rgba(0, 0, 0, 0.11);
  }

  .meta dt {
    font: 500 10px/1 'JetBrains Mono', ui-monospace, monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.34);
  }

  .meta dd {
    margin: 0;
    font: 700 14.5px/1 Helvetica, 'Helvetica Neue', Arial, sans-serif;
    color: #0d0d0d;
  }

  .meta dd a {
    color: #0d0d0d;
  }

  .open-row {
    margin-top: 26px;
    display: flex;
    gap: 11px;
    flex-wrap: wrap;
  }

  /* The only path to the live app — deliberately the loudest thing on the page. */
  .open {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 14px 22px;
    border-radius: 10px;
    background: #0d0d0d;
    font: 700 14px Helvetica, 'Helvetica Neue', Arial, sans-serif;
    color: #fff;
    text-decoration: none;
    transition: transform 0.18s ease;
  }

  .open:hover {
    color: #fff;
    transform: translateY(-2px);
  }

  .open-host {
    display: flex;
    align-items: center;
    font: 500 10.5px 'JetBrains Mono', ui-monospace, monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.34);
  }

  .shots {
    margin-top: 34px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .hero-frame {
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
  }

  .well {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #e6e9e5;
  }

  .detail {
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 10px;
    overflow: hidden;
  }

  .shot {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }

  .foot {
    margin-top: 44px;
    padding-top: 22px;
    border-top: 1px solid rgba(0, 0, 0, 0.11);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .all {
    font: 500 11px 'JetBrains Mono', ui-monospace, monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.5);
    text-decoration: none;
  }

  .all:hover {
    color: #0d0d0d;
  }

  .next {
    font: 700 20px Helvetica, 'Helvetica Neue', Arial, sans-serif;
    color: #0d0d0d;
    letter-spacing: -0.02em;
    text-decoration: none;
    text-align: right;
  }

  .next:hover {
    color: #0d0d0d;
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  @media (max-width: 759.98px) {
    .page {
      padding: 72px 22px 70px;
    }

    .back {
      top: 18px;
      left: 18px;
    }

    .title {
      font: 700 34px/1.05 Helvetica, 'Helvetica Neue', Arial, sans-serif;
    }

    .meta {
      grid-template-columns: 72px 1fr;
    }

    .details {
      grid-template-columns: 1fr;
    }
  }
</style>
