---
import '../styles/global.css';
import { withBase } from '../config/site';

interface Props {
  title: string;
  description: string;
  /** Sets the page background so there is no flash before CSS paints. */
  ground: '#04070d' | '#eef1ee';
  /**
   * Overrides the site-wide share card. Root-relative path to a 1200x630 PNG
   * under `public/` — the dimensions below are declared, not measured. Pass
   * `ogImageAlt` with it; the default alt describes the default card.
   */
  ogImage?: string;
  ogImageAlt?: string;
}

const { title, description, ground, ogImage: card, ogImageAlt } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// One card for the whole site unless a page brings its own — only the title and
// description vary per page. Regenerate the default with the script in the
// README if the name or role line changes.
const DEFAULT_OG_IMAGE = '/og-image.png';
const DEFAULT_OG_IMAGE_ALT = 'Luke To — white monospace name over a dark ASCII field';
// Absolute: a relative og:image silently fails in Slack and iMessage.
const ogImage = new URL(withBase(card ?? DEFAULT_OG_IMAGE), Astro.site);
const OG_IMAGE_ALT = ogImageAlt ?? DEFAULT_OG_IMAGE_ALT;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* SVG first for anything that can scale it; the .ico is the fallback for
        crawlers and older clients, which ask for it by name whether or not it's
        declared. The PNGs cover the browsers that read neither. */}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase('/favicon-16.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/apple-touch-icon-180.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    {/* Matches the page it's on, so the mobile browser chrome doesn't sit in
        the dark ground while the about page is white. */}
    <meta name="theme-color" content={ground} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Luke To" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {/* Lets a scraper reserve the space before it fetches the file, so the
        unfurl doesn't reflow once the image lands. */}
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />
  </head>
  <body style={`background:${ground}`}>
    <slot />
  </body>
</html>
