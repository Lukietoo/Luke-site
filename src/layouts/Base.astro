---
import '../styles/global.css';
import { withBase } from '../config/site';

interface Props {
  title: string;
  description: string;
  /** Sets the page background so there is no flash before CSS paints. */
  ground: '#04070d' | '#eef1ee';
}

const { title, description, ground } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// TODO: replace with a purpose-built 1200x630 card.
const ogImage = new URL(withBase('/og-image.png'), Astro.site);
const favicon = withBase('/favicon.svg');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Luke To" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />
  </head>
  <body style={`background:${ground}`}>
    <slot />
  </body>
</html>
